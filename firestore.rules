rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'jesidjr92@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isValidReview(data) {
      return data.keys().hasAll([
          'authorName',
          'watchName',
          'rating',
          'comment',
          'isPublic',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'authorName',
          'watchName',
          'rating',
          'comment',
          'isPublic',
          'createdAt'
        ]) &&
        data.authorName is string &&
        data.authorName.size() >= 2 &&
        data.authorName.size() <= 60 &&
        data.watchName is string &&
        data.watchName.size() >= 2 &&
        data.watchName.size() <= 100 &&
        data.rating is int &&
        data.rating >= 1 &&
        data.rating <= 5 &&
        data.comment is string &&
        data.comment.size() >= 3 &&
        data.comment.size() <= 600 &&
        data.isPublic is bool &&
        data.createdAt is timestamp;
    }

    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && existing().isPublic == true;
      allow list: if existing().isPublic == true;
      allow create: if isValidId(reviewId) &&
        isValidReview(incoming()) &&
        incoming().isPublic == true &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(reviewId) && isAdmin();
    }
  }
}
